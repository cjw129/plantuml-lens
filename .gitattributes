# Stdlib bundles are byte-for-byte copies of the published files at
# https://plantuml.github.io/plantuml/js-plantuml/ and must stay that way,
# so keep git from normalizing their line endings on checkout.
*.min.js -text
# Same for the engine's support scripts, fetched from the same place.
emoji.js -text
themes.js -text
openiconic.js -text
# extension/vendor/plantuml.js is the vendored TeaVM engine and the top-level
# *.min.js files are stdlib bundles fetched by fetch_stdlib.py. Mark them
# generated so GitHub collapses their diffs and drops them from language stats.
extension/vendor/** linguist-generated=true
extension/*.min.js linguist-generated=true
