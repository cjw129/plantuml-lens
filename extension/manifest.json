{
  "manifest_version": 3,
  "name": "PlantUML Lens",
  "version": "0.4.0",
  "description": "Renders plantuml code blocks on GitHub, local files and sites you add, entirely in the browser with a client-side PlantUML engine.",
  "author": "cjw129",
  "homepage_url": "https://github.com/cjw129/plantuml-lens",


  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://*.ghe.com/*",
        "file:///*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "renderer.html",
        "renderer.js",
        "vendor/plantuml.js",
        "adaml.min.js",
        "archimate.min.js",
        "azure.min.js",
        "c4.min.js",
        "classy-c4.min.js",
        "classy.min.js",
        "cloudinsight.min.js",
        "cloudogu.min.js",
        "domainstory.min.js",
        "edgy.min.js",
        "eip.min.js",
        "elastic.min.js",
        "gcp.min.js",
        "k8s.min.js",
        "kubernetes.min.js",
        "osa2.min.js",
        "awslib10.min.js",
        "bootstrap.min.js",
        "bootstrap1.13.1.min.js",
        "office.min.js",
        "osa.min.js",
        "awslib.min.js",
        "awslib14.min.js",
        "awslib20.min.js",
        "ibm.min.js",
        "logos.min.js",
        "material.min.js",
        "material2.min.js",
        "material2.1.19.min.js",
        "tupadr3.min.js",
        "emoji.js",
        "themes.js",
        "openiconic.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": ["clipboardWrite", "storage", "scripting"],

  "optional_host_permissions": ["*://*/*"],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
